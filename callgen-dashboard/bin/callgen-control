#!/bin/bash
# ==============================================================================
# M5-Traffic Controller Control Utility - Database-Driven (SQLite / Asterisk)
# Manages systemd services, live CDR usage & active channels for all 3 trunks
# ==============================================================================

set -euo pipefail

AST="$(command -v asterisk 2>/dev/null || echo '/usr/sbin/asterisk')"
CMD="${1:-status}"
TRUNK="${2:-all}"

TRUNKS=("mali" "cuba" "senegal")

service_name() {
    echo "asterisk-callgen-${1}.service"
}

check_limit() {
    local t="$1"
    local reached
    reached=$(python3 - "$t" <<'PY'
import sys
try:
    import callgen_db
    t = sys.argv[1]
    conn = callgen_db.get_connection()
    row = conn.execute("SELECT target_ip, monthly_limit FROM trunks WHERE id=?", (t,)).fetchone()
    conn.close()
    if not row:
        sys.exit(0)
    limit_sec = int(row['monthly_limit']) * 60
    sec = callgen_db.get_month_consumed_seconds(row['target_ip'], t)
    print("1" if sec >= limit_sec else "0")
except Exception:
    print("0")
PY
    )
    [ "$reached" = "1" ] && return 1 || return 0
}

case "$CMD" in
    start)
        if [ "$TRUNK" = "all" ]; then
            started=0
            blocked=0
            for t in "${TRUNKS[@]}"; do
                if check_limit "$t"; then
                    systemctl start "$(service_name "$t")"
                    started=$((started + 1))
                else
                    echo "Notice: ${t} quota is maxed out; route remains stopped." >&2
                    blocked=$((blocked + 1))
                fi
            done
            if [ "$started" -gt 0 ]; then
                echo "Started ${started} active route(s)."
            else
                echo "Cannot start routes: monthly limits are reached." >&2
                exit 1
            fi
        else
            if ! check_limit "$TRUNK"; then
                echo "Error: Cannot start ${TRUNK}: Monthly minute limit is reached. Increase limit first." >&2
                exit 1
            fi
            systemctl start "$(service_name "$TRUNK")"
            echo "Started ${TRUNK} route."
        fi
        ;;

    stop)
        if [ "$TRUNK" = "all" ]; then
            for t in "${TRUNKS[@]}"; do
                systemctl stop "$(service_name "$t")" || true
            done
            echo "Stopped all 3 call generation routes."
        else
            systemctl stop "$(service_name "$TRUNK")"
            echo "Stopped ${TRUNK} route."
        fi
        ;;

    hangup)
        if [ "$TRUNK" = "all" ]; then
            rm -f /var/spool/asterisk/outgoing/callgen_* /var/spool/asterisk/outgoing/*_callgen_* /tmp/callgen_* || true
            for t in "${TRUNKS[@]}"; do
                rm -f /var/spool/asterisk/outgoing/${t}_* /tmp/${t}_* || true
                "$AST" -rx "channel request hangup /^PJSIP\/${t}-trunk/" || true
            done
            chs=$("$AST" -rx "core show channels concise" 2>/dev/null | cut -d'!' -f1 || true)
            for c in $chs; do
                if echo "$c" | grep -qE "PJSIP/(mali|cuba|senegal)-trunk"; then
                    "$AST" -rx "channel request hangup $c" 2>/dev/null || true
                fi
            done
            echo "Requested hangup for all active channels across all routes."
        else
            rm -f /var/spool/asterisk/outgoing/${TRUNK}_* /tmp/${TRUNK}_* /var/spool/asterisk/outgoing/*_${TRUNK}_* || true
            out=$("$AST" -rx "channel request hangup /^PJSIP\/${TRUNK}-trunk/" 2>&1 || true)
            chs=$("$AST" -rx "core show channels concise" 2>/dev/null | grep -E "PJSIP/${TRUNK}-trunk" | cut -d'!' -f1 || true)
            for c in $chs; do
                "$AST" -rx "channel request hangup $c" 2>/dev/null || true
            done
            echo "Hangup signal sent to ${TRUNK} route channels. ${out}"
        fi
        ;;

    reload)
        /usr/local/sbin/callgen-sync-inbound.py || true
        echo "Configuration reloaded. Engine updates within 5s."
        ;;

    reset-quota|reset)
        python3 - "$TRUNK" <<'PY'
import sys, json, os, datetime
trunk = sys.argv[1]
try:
    import callgen_db
    now_str = callgen_db.reset_trunk_quota(trunk)
    trunks = ['mali', 'cuba', 'senegal'] if trunk == 'all' else [trunk]
    for t in trunks:
        conf_path = f'/etc/callgen-{t}.json'
        if os.path.exists(conf_path):
            try:
                with open(conf_path, 'r') as f:
                    d = json.load(f)
                d['quota_reset_at'] = now_str
                d['used_minutes'] = 0.0
                d['limit_reached'] = False
                with open(conf_path, 'w') as f:
                    json.dump(d, f, indent=2)
            except Exception:
                pass
    print(f"Reset quota to 0.0 min for {trunk}")
except Exception as e:
    print(f"Error resetting quota: {e}", file=sys.stderr)
    sys.exit(1)
PY
        ;;

    trim-cdrs|cleanup-cdrs)
        python3 - "${2:-100}" <<'PY'
import sys
keep = 100
if len(sys.argv) > 1 and sys.argv[1].isdigit():
    keep = int(sys.argv[1])
try:
    import callgen_db
    res = callgen_db.trim_cdrs(keep)
    c_res = callgen_db.trim_master_csv(keep)
    print(f"CDRs trimmed: kept {res.get('kept', keep)}, deleted {res.get('deleted', 0)} from DB, {c_res} lines trimmed from CSV.")
except Exception as e:
    print(f"Error trimming CDRs: {e}", file=sys.stderr)
PY
        ;;

    save-inbound|sync-inbound)
        if [ -n "${2:-}" ] && [ "$2" != "{}" ]; then
            python3 - "$2" <<'PY' || true
import sys, json, os
try:
    data = json.loads(sys.argv[1])
    import callgen_db
    conn = callgen_db.get_connection()
    with conn:
        if 'source_ips' in data and isinstance(data['source_ips'], list):
            conn.execute("DELETE FROM gateways;")
            for idx, s in enumerate(data['source_ips']):
                sip = s.get('ip', '').strip()
                if not sip: continue
                port = int(s.get('port') or 5060)
                if ':' in sip:
                    sip, pstr = sip.split(':', 1)
                    if not s.get('port') and pstr.isdigit():
                        port = int(pstr)
                conn.execute("""
                INSERT INTO gateways (id, ip, port, label, prefix, country_code, context, is_active)
                VALUES (?, ?, ?, ?, ?, ?, ?, 1)
                """, (
                    s.get('id', f'src-{idx+1}'),
                    sip,
                    port,
                    s.get('label', f'Gateway {idx+1}'),
                    s.get('prefix', ''),
                    s.get('country_code', ''),
                    s.get('context', 'auto')
                ))
        if 'testcall_duration' in data:
            conn.execute("INSERT OR REPLACE INTO inbound_config (key, value) VALUES ('testcall_duration', ?)", (str(data['testcall_duration']),))
        if 'testcall2_duration' in data:
            conn.execute("INSERT OR REPLACE INTO inbound_config (key, value) VALUES ('testcall2_duration', ?)", (str(data['testcall2_duration']),))
        if 'testcall_prefixes' in data:
            conn.execute("INSERT OR REPLACE INTO inbound_config (key, value) VALUES ('testcall_prefixes', ?)", (str(data['testcall_prefixes']),))
        if 'testcall2_prefixes' in data:
            conn.execute("INSERT OR REPLACE INTO inbound_config (key, value) VALUES ('testcall2_prefixes', ?)", (str(data['testcall2_prefixes']),))
    conn.close()

    conf_path = '/etc/callgen-inbound.json'
    with open(conf_path, 'w') as f:
        json.dump(data, f, indent=2)
    os.chmod(conf_path, 0o664)
    print("Saved inbound configuration to database")
except Exception as e:
    print(f"Notice: database sync inbound: {e}", file=sys.stderr)
PY
        fi
        /usr/local/sbin/callgen-sync-inbound.py || true
        ;;

    save)
        python3 - "$TRUNK" "${3:-{}}" <<'PY'
import sys, json, os
trunk = sys.argv[1]
if trunk not in ['cuba', 'senegal', 'mali']:
    sys.exit(1)
try:
    data = json.loads(sys.argv[2])
    import callgen_db
    conn = callgen_db.get_connection()
    raw_ip = str(data.get('target_ip') or '').strip()
    raw_port = int(data.get('sip_port') or 5060)
    if ':' in raw_ip:
        parts = raw_ip.split(':', 1)
        raw_ip = parts[0]
        if not data.get('sip_port') and parts[1].isdigit():
            raw_port = int(parts[1])
    if raw_port < 1 or raw_port > 65535:
        raw_port = 5060
    full_target = f"{raw_ip}:{raw_port}" if raw_ip else ""
    data['target_ip'] = full_target
    data['sip_port'] = raw_port

    with conn:
        conn.execute("""
        UPDATE trunks SET
            name = COALESCE(?, name),
            target_ip = COALESCE(?, target_ip),
            sip_port = COALESCE(?, sip_port),
            prefix = COALESCE(?, prefix),
            country_code = COALESCE(?, country_code),
            prefix_cid = COALESCE(?, prefix_cid),
            monthly_limit = COALESCE(?, monthly_limit),
            max_channels = COALESCE(?, max_channels),
            call_duration = COALESCE(?, call_duration),
            context = COALESCE(?, context),
            updated_at = CURRENT_TIMESTAMP
        WHERE id = ?;
        """, (
            data.get('name'),
            full_target,
            raw_port,
            data.get('prefix'),
            data.get('country_code'),
            data.get('prefix_cid'),
            data.get('monthly_limit'),
            data.get('max_channels'),
            data.get('call_duration'),
            data.get('context'),
            trunk
        ))
    conn.close()

    conf_path = f'/etc/callgen-{trunk}.json'
    with open(conf_path, 'w') as f:
        json.dump(data, f, indent=2)
    os.chmod(conf_path, 0o664)
    print(f"Saved database configuration for {trunk}")
except Exception as e:
    print(f"Error saving {trunk}: {e}", file=sys.stderr)
    sys.exit(1)
PY
        /usr/local/sbin/callgen-sync-inbound.py || true
        ;;

    status)
        python3 - "$TRUNK" <<'PY'
import json, subprocess, os, sys, re, shutil
from datetime import datetime

for p in ['/usr/local/sbin', '/usr/local/bin', '/var/lib/callgen', os.path.dirname(os.path.abspath(__file__)) if '__file__' in dir() else '']:
    if p and os.path.exists(p) and p not in sys.path:
        sys.path.insert(0, p)

try:
    import callgen_db
except Exception:
    callgen_db = None

ast_bin = shutil.which('asterisk') or '/usr/sbin/asterisk'
target_trunk = sys.argv[1] if len(sys.argv) > 1 else 'all'
trunks = ['mali', 'cuba', 'senegal']

# Incremental sync of recent CSV lines to SQLite (if CSV exists)
if callgen_db:
    try:
        callgen_db.sync_cdrs_from_csv()
    except Exception:
        pass

try:
    s = subprocess.run([ast_bin, '-rx', 'core show channels'], capture_output=True, text=True).stdout
except Exception:
    s = ""

result = {}
db_trunks = {}
if callgen_db:
    try:
        db_trunks = {t['id']: t for t in callgen_db.get_all_trunks()}
    except Exception:
        db_trunks = {}

# Fallback to callgen-config.json if database had no trunks
if not db_trunks:
    for cfg_cand in ['/var/lib/callgen/callgen-config.json', '/etc/callgen-config.json']:
        if os.path.exists(cfg_cand):
            try:
                with open(cfg_cand, 'r') as f:
                    cfg_j = json.load(f)
                    db_trunks = cfg_j.get('trunks', {})
                    if not db_trunks:
                        db_trunks = {t: cfg_j[t] for t in ['cuba', 'mali', 'senegal'] if t in cfg_j and isinstance(cfg_j[t], dict)}
                    if db_trunks: break
            except Exception:
                pass

# Default trunks if still empty
if not db_trunks:
    db_trunks = {
        'cuba': {'id': 'cuba', 'name': 'Cuba', 'target_ip': '192.168.88.76:5060', 'sip_port': 5060, 'prefix': '4444', 'country_code': '53', 'prefix_cid': '444453', 'monthly_limit': 5000, 'max_channels': 600, 'context': 'testcall'},
        'mali': {'id': 'mali', 'name': 'Mali', 'target_ip': '192.168.88.76:5060', 'sip_port': 5060, 'prefix': '', 'country_code': '2237', 'prefix_cid': '2237', 'monthly_limit': 1000000, 'max_channels': 2000, 'context': 'testcall2'},
        'senegal': {'id': 'senegal', 'name': 'Senegal', 'target_ip': '178.22.15.201:5060', 'sip_port': 5060, 'prefix': '619334', 'country_code': '221', 'prefix_cid': '619334221', 'monthly_limit': 150000, 'max_channels': 600, 'context': 'testcall'}
    }

for t in trunks:
    cfg = dict(db_trunks.get(t, {}))
    if not cfg:
        continue
    ip = cfg.get('target_ip', '')
    port = int(cfg.get('sip_port') or 5060)
    srv = f'asterisk-callgen-{t}.service'
    raw_running = False
    try:
        raw_running = subprocess.run(['systemctl', 'is-active', '--quiet', srv]).returncode == 0
    except Exception:
        raw_running = False
    active = sum((ip in x or f'{t}-trunk' in x) and ('SIP/' in x or 'PJSIP/' in x) for x in s.splitlines()) if s else 0

    # Fast indexed SQL lookup
    sec = 0
    if callgen_db:
        try:
            sec = callgen_db.get_month_consumed_seconds(ip, t)
        except Exception:
            sec = 0

    limit_sec = int(cfg.get('monthly_limit', 100000)) * 60
    limit_reached = sec >= limit_sec

    # If limit reached, auto-stop service if still running
    if limit_reached and raw_running:
        try:
            subprocess.run(['systemctl', 'stop', srv])
        except Exception:
            pass
        raw_running = False

    host = ip.split(':')[0] if ':' in ip else ip
    cfg['id'] = t
    cfg['target_ip'] = f"{host}:{port}" if host else ""
    cfg['sip_port'] = port
    cfg['running'] = raw_running and not limit_reached
    cfg['limit_reached'] = limit_reached
    cfg['active_calls'] = active if not limit_reached else 0
    cfg['used_minutes'] = round(sec / 60, 2)
    result[t] = cfg

# Inbound Configuration from Database or Config
inbound_cfg_dict = {}
gateways = []
if callgen_db:
    try:
        inbound_cfg_dict = callgen_db.get_inbound_config_dict()
        gateways = callgen_db.get_all_gateways()
    except Exception:
        pass

if not gateways:
    for cfg_cand in ['/var/lib/callgen/callgen-config.json', '/etc/callgen-config.json']:
        if os.path.exists(cfg_cand):
            try:
                with open(cfg_cand, 'r') as f:
                    cfg_j = json.load(f)
                    inbound_raw = cfg_j.get('_inbound', cfg_j.get('inbound', {}))
                    gateways = inbound_raw.get('source_ips', [])
                    if not inbound_cfg_dict:
                        inbound_cfg_dict = inbound_raw
                    if gateways: break
            except Exception:
                pass

inbound_cfg = {
    'source_ips': gateways,
    'source_ip': ', '.join([g.get('ip', '') for g in gateways]),
    'testcall_duration': int(inbound_cfg_dict.get('testcall_duration', 60)),
    'testcall2_duration': int(inbound_cfg_dict.get('testcall2_duration', 50)),
    'testcall_prefixes': inbound_cfg_dict.get('testcall_prefixes', '444453, 619334221'),
    'testcall2_prefixes': inbound_cfg_dict.get('testcall2_prefixes', '2237')
}

# Country records from Database SQL
country_records = {'mali': {'active': 0}, 'cuba': {'active': 0}, 'senegal': {'active': 0}}
if callgen_db:
    try:
        country_records = callgen_db.get_country_records()
    except Exception:
        pass

# Active Inbound Channels
active_inbound = []
try:
    sc = subprocess.run([ast_bin, '-rx', 'core show channels concise'], capture_output=True, text=True).stdout
    for line in sc.splitlines():
        parts = line.strip().split('!')
        if len(parts) >= 9:
            chan = parts[0]
            if 'trunk-inbound' in chan or 'trunk-13' in chan:
                ctx = parts[1]
                exten = parts[2]
                acc = parts[9] if len(parts) > 9 else ''
                did = acc if (acc and acc != 's') else exten
                clean = re.sub(r'[^0-9]', '', str(did or ''))
                ck = None
                if clean.startswith('2237') or clean.startswith('223'):
                    ck = 'mali'
                elif clean.startswith('444453') or clean.startswith('4444') or clean.startswith('53'):
                    ck = 'cuba'
                elif clean.startswith('619334221') or clean.startswith('619334') or clean.startswith('221'):
                    ck = 'senegal'
                if ck and ck in country_records:
                    country_records[ck]['active'] += 1
                active_inbound.append({
                    'channel': chan,
                    'context': ctx,
                    'did': did,
                    'duration': parts[8] if len(parts) > 8 else '0'
                })
except Exception:
    pass

# Recent calls from Database SQL
recent_inbound = []
if callgen_db:
    try:
        conn = callgen_db.get_connection()
        cur = conn.cursor()
        cur.execute("""
        SELECT calldate, dst, dcontext, disposition, duration, userfield
        FROM cdr
        WHERE channel LIKE '%trunk-inbound%' OR channel LIKE '%trunk-13%' OR userfield LIKE 'inbound:%'
        ORDER BY calldate DESC
        LIMIT 20;
        """)
        for r in cur.fetchall():
            u = r['userfield'] or ''
            did = ''
            if u.startswith('inbound:'):
                p = u.split(':')
                if len(p) >= 2: did = p[1]
            if not did: did = r['dst']
            recent_inbound.append({
                'timestamp': r['calldate'],
                'did': did,
                'context': r['dcontext'],
                'status': r['disposition'],
                'duration': r['duration']
            })
        conn.close()
    except Exception:
        pass

inbound_res = dict(inbound_cfg)
inbound_res['active_channels'] = len(active_inbound)
inbound_res['active_calls'] = active_inbound
inbound_res['country_records'] = country_records
inbound_res['recent_calls'] = recent_inbound

if target_trunk in result:
    print(json.dumps({'trunk': result[target_trunk]}))
else:
    print(json.dumps({'trunks': result, 'inbound': inbound_res}))
PY
        ;;

    *)
        echo "Usage: callgen-control {start|stop|reload|status} [cuba|senegal|mali|all]" >&2
        exit 2
        ;;
esac
