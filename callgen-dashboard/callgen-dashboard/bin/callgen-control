#!/bin/bash
# ==============================================================================
# M5-Traffic Controller Control Utility - Asterisk 23 / PJSIP
# Manages systemd services, live CDR usage & active channels for all 3 trunks
# ==============================================================================

set -euo pipefail

CMD="${1:-status}"
TRUNK="${2:-all}"

TRUNKS=("mali" "cuba" "senegal")

service_name() {
    echo "asterisk-callgen-${1}.service"
}

check_limit() {
    local t="$1"
    local conf="/etc/callgen-${t}.json"
    [ -f "$conf" ] || return 0
    local reached
    reached=$(python3 - "$conf" "$t" <<'PY'
import json, csv, os, sys
from datetime import datetime
try:
    c = json.load(open(sys.argv[1]))
    t = sys.argv[2]
    ip = c['target_ip']
    limit_sec = int(c['monthly_limit']) * 60
    f = '/var/log/asterisk/cdr-csv/Master.csv'
    m = datetime.now().strftime('%Y-%m')
    sec = 0
    if os.path.exists(f):
        with open(f, newline='') as h:
            for r in csv.reader(h):
                if len(r) >= 15 and r[14] == 'ANSWERED' and r[9].startswith(m):
                    if ip in r[5] or ip in r[6] or f'{t}-trunk' in r[5] or f'{t}-trunk' in r[6]:
                        try: sec += int(r[13])
                        except: pass
    print("1" if sec >= limit_sec else "0")
except Exception:
    print("0")
PY
    )
    [ "$reached" = "1" ] && return 1 || return 0
}

case "$CMD" in
    start)
        if [ "$TRUNK" = "all" ]; then
            started=0
            blocked=0
            for t in "${TRUNKS[@]}"; do
                if check_limit "$t"; then
                    systemctl start "$(service_name "$t")"
                    started=$((started + 1))
                else
                    echo "Notice: ${t} quota is maxed out; route remains stopped." >&2
                    blocked=$((blocked + 1))
                fi
            done
            if [ "$started" -gt 0 ]; then
                echo "Started ${started} active route(s)."
            else
                echo "Cannot start routes: monthly limits are reached." >&2
                exit 1
            fi
        else
            if ! check_limit "$TRUNK"; then
                echo "Error: Cannot start ${TRUNK}: Monthly minute limit is reached. Increase limit first." >&2
                exit 1
            fi
            systemctl start "$(service_name "$TRUNK")"
            echo "Started ${TRUNK} route."
        fi
        ;;

    stop)
        if [ "$TRUNK" = "all" ]; then
            for t in "${TRUNKS[@]}"; do
                systemctl stop "$(service_name "$t")" || true
            done
            echo "Stopped all 3 call generation routes."
        else
            systemctl stop "$(service_name "$TRUNK")"
            echo "Stopped ${TRUNK} route."
        fi
        ;;

    reload)
        /usr/local/sbin/callgen-sync-inbound.py || true
        echo "Configuration reloaded. Engine updates within 5s."
        ;;

    save-inbound)
        python3 - "${2:-{}}" <<'PY'
import sys, json, os
try:
    data = json.loads(sys.argv[1])
    conf_path = '/etc/callgen-inbound.json'
    with open(conf_path, 'w') as f:
        json.dump(data, f, indent=2)
    os.chmod(conf_path, 0o664)
    try:
        import grp
        gid = grp.getgrnam("apache").gr_gid
        os.chown(conf_path, 0, gid)
    except Exception:
        pass
    print("Saved inbound configuration")
except Exception as e:
    print(f"Error saving inbound: {e}", file=sys.stderr)
    sys.exit(1)
PY
        /usr/local/sbin/callgen-sync-inbound.py || true
        ;;

    save)
        python3 - "$TRUNK" "${3:-{}}" <<'PY'
import sys, json, os
trunk = sys.argv[1]
if trunk not in ['cuba', 'senegal', 'mali']:
    sys.exit(1)
try:
    data = json.loads(sys.argv[2])
    conf_path = f'/etc/callgen-{trunk}.json'
    with open(conf_path, 'w') as f:
        json.dump(data, f, indent=2)
    os.chmod(conf_path, 0o664)
    try:
        import grp
        gid = grp.getgrnam("apache").gr_gid
        os.chown(conf_path, 0, gid)
    except Exception:
        pass
    print(f"Saved configuration for {trunk}")
except Exception as e:
    print(f"Error saving {trunk}: {e}", file=sys.stderr)
    sys.exit(1)
PY
        /usr/local/sbin/callgen-sync-inbound.py || true
        ;;

    status)
        python3 - "$TRUNK" <<'PY'
import json, csv, subprocess, os, sys, re
from datetime import datetime

target_trunk = sys.argv[1] if len(sys.argv) > 1 else 'all'
trunks = ['mali', 'cuba', 'senegal']

default_configs = {
    'mali': {'name': 'Mali', 'target_ip': '202.125.153.97', 'prefix': '', 'country_code': '2237', 'prefix_cid': '2237', 'monthly_limit': 100000, 'max_channels': 150, 'call_duration': 600, 'context': 'testcall2'},
    'cuba': {'name': 'Cuba', 'target_ip': '206.251.255.21', 'prefix': '4444', 'country_code': '53', 'prefix_cid': '444453', 'monthly_limit': 250000, 'max_channels': 400, 'call_duration': 600, 'context': 'testcall'},
    'senegal': {'name': 'Senegal', 'target_ip': '178.22.15.201', 'prefix': '619334', 'country_code': '221', 'prefix_cid': '619334221', 'monthly_limit': 150000, 'max_channels': 220, 'call_duration': 600, 'context': 'testcall'}
}

COUNTRY_PREFIXES = [
    ('2237', 'Mali', '223', 'ML'),
    ('223', 'Mali', '223', 'ML'),
    ('444453', 'Cuba', '53', 'CU'),
    ('4444', 'Cuba (Prefix)', '53', 'CU'),
    ('53', 'Cuba', '53', 'CU'),
    ('619334221', 'Senegal', '221', 'SN'),
    ('619334', 'Senegal (Prefix)', '221', 'SN'),
    ('221', 'Senegal', '221', 'SN'),
    ('86', 'China', '86', 'CN'),
    ('44', 'United Kingdom', '44', 'GB'),
    ('1', 'USA / Canada', '1', 'US'),
    ('91', 'India', '91', 'IN'),
    ('92', 'Pakistan', '92', 'PK'),
    ('49', 'Germany', '49', 'DE'),
    ('33', 'France', '33', 'FR'),
    ('34', 'Spain', '34', 'ES'),
    ('39', 'Italy', '39', 'IT'),
    ('7', 'Russia', '7', 'RU'),
    ('81', 'Japan', '81', 'JP'),
    ('90', 'Turkey', '90', 'TR'),
    ('971', 'UAE', '971', 'AE'),
    ('20', 'Egypt', '20', 'EG'),
    ('27', 'South Africa', '27', 'ZA'),
    ('234', 'Nigeria', '234', 'NG'),
]

def resolve_country(did):
    clean = re.sub(r'[^0-9]', '', str(did or ''))
    if not clean or clean == '0':
        return {'country': 'Unknown / Test', 'code': 'N/A', 'flag': 'XX'}
    for pfx, country, cc, flag in COUNTRY_PREFIXES:
        if clean.startswith(pfx):
            return {'country': country, 'code': cc, 'flag': flag}
    cc = clean[:3] if len(clean) >= 3 else clean
    return {'country': f'Country +{cc}', 'code': cc, 'flag': 'XX'}

try:
    s = subprocess.run(['/usr/sbin/asterisk', '-rx', 'core show channels'], capture_output=True, text=True).stdout
except Exception:
    s = ""

cdr_file = '/var/log/asterisk/cdr-csv/Master.csv'
current_month = datetime.now().strftime('%Y-%m')
cdr_rows = []
all_cdr_rows = []
if os.path.exists(cdr_file):
    try:
        with open(cdr_file, newline='') as h:
            for r in csv.reader(h):
                if len(r) >= 15 and r[9].startswith(current_month):
                    all_cdr_rows.append(r)
                    if r[14] == 'ANSWERED':
                        cdr_rows.append(r)
    except Exception:
        pass

result = {}

for t in trunks:
    cfg = dict(default_configs[t])
    conf_path = f'/etc/callgen-{t}.json'
    if os.path.exists(conf_path):
        try:
            cfg.update(json.load(open(conf_path)))
        except Exception:
            pass

    ip = cfg['target_ip']
    srv = f'asterisk-callgen-{t}.service'
    raw_running = subprocess.run(['systemctl', 'is-active', '--quiet', srv]).returncode == 0
    active = sum((ip in x or f'{t}-trunk' in x) and ('SIP/' in x or 'PJSIP/' in x) for x in s.splitlines())

    sec = 0
    for r in cdr_rows:
        if ip in r[5] or ip in r[6] or f'{t}-trunk' in r[5] or f'{t}-trunk' in r[6]:
            try:
                sec += int(r[13])
            except Exception:
                pass

    limit_sec = int(cfg['monthly_limit']) * 60
    limit_reached = sec >= limit_sec

    # If limit reached, auto-stop service if still running
    if limit_reached and raw_running:
        subprocess.run(['systemctl', 'stop', srv])
        raw_running = False

    cfg['id'] = t
    cfg['running'] = raw_running and not limit_reached
    cfg['limit_reached'] = limit_reached
    cfg['active_calls'] = active if not limit_reached else 0
    cfg['used_minutes'] = round(sec / 60, 2)
    result[t] = cfg

# Inbound Configuration
inbound_conf_path = '/etc/callgen-inbound.json'
inbound_cfg = {
    'source_ips': [
        {
            'id': 'src-1',
            'ip': '192.168.1.13',
            'label': 'Node-13 Forwarder',
            'prefix': '2237, 4444, 53, 619334, 221',
            'country_code': '223, 53, 221',
            'context': 'auto'
        }
    ],
    'source_ip': '192.168.1.13',
    'testcall_duration': 600,
    'testcall2_duration': 550,
    'testcall2_prefixes': '2237',
    'testcall_prefixes': '4444, 53, 619334, 221'
}
if os.path.exists(inbound_conf_path):
    try:
        inbound_cfg.update(json.load(open(inbound_conf_path)))
    except Exception:
        pass

# Target Country Minutes Records (Cuba, Mali, Senegal)
country_records = {
    'mali': {'name': 'Mali', 'code': '223', 'prefix': '2237', 'flag': 'ML', 'context': 'testcall2', 'calls': 0, 'answered': 0, 'minutes': 0.0, 'active': 0},
    'cuba': {'name': 'Cuba', 'code': '53', 'prefix': '4444, 53', 'flag': 'CU', 'context': 'testcall', 'calls': 0, 'answered': 0, 'minutes': 0.0, 'active': 0},
    'senegal': {'name': 'Senegal', 'code': '221', 'prefix': '619334, 221', 'flag': 'SN', 'context': 'testcall', 'calls': 0, 'answered': 0, 'minutes': 0.0, 'active': 0}
}

def match_target_country(did):
    clean = re.sub(r'[^0-9]', '', str(did or ''))
    if clean.startswith('2237') or clean.startswith('223'):
        return 'mali'
    if clean.startswith('444453') or clean.startswith('4444') or clean.startswith('53'):
        return 'cuba'
    if clean.startswith('619334221') or clean.startswith('619334') or clean.startswith('221'):
        return 'senegal'
    return None

# Active Inbound Channels
active_inbound = []
try:
    sc = subprocess.run(['/usr/sbin/asterisk', '-rx', 'core show channels concise'], capture_output=True, text=True).stdout
    for line in sc.splitlines():
        parts = line.strip().split('!')
        if len(parts) >= 9:
            chan = parts[0]
            if 'trunk-inbound' in chan or 'trunk-13' in chan:
                ctx = parts[1]
                exten = parts[2]
                acc = parts[9] if len(parts) > 9 else ''
                did = acc if (acc and acc != 's') else exten
                cinfo = resolve_country(did)
                ck = match_target_country(did)
                if ck:
                    country_records[ck]['active'] += 1
                active_inbound.append({
                    'channel': chan,
                    'context': ctx,
                    'did': did,
                    'duration': parts[8] if len(parts) > 8 else '0',
                    'country': cinfo['country'],
                    'code': cinfo['code'],
                    'flag': cinfo['flag']
                })
except Exception:
    pass

# Inbound CDR summary & recent calls
recent_inbound = []

for r in reversed(all_cdr_rows):
    chan = r[5]
    userfield = r[17] if len(r) > 17 else ''
    is_in = ('trunk-inbound' in chan or 'trunk-13' in chan or userfield.startswith('inbound:'))
    if not is_in:
        continue

    sec = int(r[13]) if r[13].isdigit() else 0
    ctx = r[3]
    status = r[14]
    did = ''
    if userfield.startswith('inbound:'):
        u_parts = userfield.split(':')
        if len(u_parts) >= 2:
            did = u_parts[1]
    if not did:
        did = r[0] if (r[0] and r[0] != 's') else (r[1] or r[2])

    cinfo = resolve_country(did)
    ck = match_target_country(did)
    if ck:
        country_records[ck]['calls'] += 1
        if status == 'ANSWERED':
            country_records[ck]['answered'] += 1
            country_records[ck]['minutes'] = round(country_records[ck]['minutes'] + sec/60.0, 2)

    if len(recent_inbound) < 20:
        recent_inbound.append({
            'timestamp': r[9],
            'did': did,
            'context': ctx,
            'status': status,
            'duration': sec,
            'country': cinfo['country'],
            'code': cinfo['code'],
            'flag': cinfo['flag']
        })

inbound_res = dict(inbound_cfg)
inbound_res['active_channels'] = len(active_inbound)
inbound_res['active_calls'] = active_inbound
inbound_res['country_records'] = country_records
inbound_res['recent_calls'] = recent_inbound

if target_trunk in result:
    print(json.dumps({'trunk': result[target_trunk]}))
else:
    print(json.dumps({'trunks': result, 'inbound': inbound_res}))
PY
        ;;

    *)
        echo "Usage: callgen-control {start|stop|reload|status} [cuba|senegal|mali|all]" >&2
        exit 2
        ;;
esac
